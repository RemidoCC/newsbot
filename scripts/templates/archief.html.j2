{% extends "base.html.j2" %}
{% block title %}newsbot — archief{% endblock %}

{% block content %}
<div class="wrap">

  <div class="datumkop">
    <h1>Archief</h1>
    <p class="datumkop-sub">De laatste {{ archive | length }} digests.</p>
  </div>

  {% if archive %}
  {# Zoeken over alle bewaarde dagen tegelijk. De index wordt pas opgehaald
     zodra je typt, zodat deze pagina licht blijft voor wie alleen de lijst
     met dagen wil. #}
  <div class="zoek">
    <label class="visually-hidden" for="archiefzoek">Zoeken in het archief</label>
    <input id="archiefzoek" type="search" autocomplete="off" spellcheck="false"
           placeholder="Zoeken in alle {{ archive | length }} dagen">
    <div class="zoekfilters" role="group" aria-label="Kanaal">
      <button type="button" class="filterknop" data-kanaal="" aria-pressed="true">Alles</button>
      {% for channel in channels %}
      <button type="button" class="filterknop" data-kanaal="{{ channel.key }}"
              aria-pressed="false">{{ channel.label }}</button>
      {% endfor %}
    </div>
    <p class="zoek-uitslag" role="status" aria-live="polite"></p>
  </div>

  <div class="zoekresultaten" hidden></div>
  {% endif %}

  {% if not archive %}
  <p class="leeg">Nog geen digests bewaard.</p>
  {% else %}
  <ol class="archieflijst">
    {% for entry in archive %}
    <li>
      <a href="archief/{{ entry.date }}.html">
        <span class="archief-datum">{{ entry.date | dutch_date }}</span>
        <span class="archief-meta">
          {{ entry.ai }} AI
          <span class="dot">·</span>
          {{ entry.bieb }} bibliotheek
        </span>
      </a>
    </li>
    {% endfor %}
  </ol>
  {% endif %}

</div>
{% endblock %}

{% block scripts %}
<script src="{{ base }}assets/archiefzoek.js" defer></script>
{% endblock %}
